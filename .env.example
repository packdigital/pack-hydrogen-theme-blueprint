# Copy this file to `.env` and fill in your values. Never commit `.env`.
# Variables prefixed with PUBLIC_ are exposed to the browser via `window.ENV`.

# ------------------------------------------------------------------------------
# Required
# ------------------------------------------------------------------------------

# Secret used to sign session cookies (any long random string)
SESSION_SECRET="replace-with-a-long-random-string"
# Your Shopify store domain
PUBLIC_STORE_DOMAIN="your-store.myshopify.com"
# Storefront API public access token
PUBLIC_STOREFRONT_API_TOKEN="your-public-storefront-api-token"
# Pack API secret token (Pack admin > Settings)
PACK_SECRET_TOKEN="your-pack-secret-token"
# Pack storefront ID (Pack admin > Settings)
PACK_STOREFRONT_ID="your-pack-storefront-id"

# ------------------------------------------------------------------------------
# Optional: Shopify
# ------------------------------------------------------------------------------

# Hydrogen storefront ID, used for Shopify analytics attribution
PUBLIC_STOREFRONT_ID=""
# Storefront API private (delegate) token for server-side requests
PRIVATE_STOREFRONT_API_TOKEN=""
# Admin API access token; enables the `context.admin` client when set
PRIVATE_ADMIN_API_TOKEN=""
# Checkout domain used by Shopify's consent/privacy banner
PUBLIC_CHECKOUT_DOMAIN=""
# Primary storefront URL (e.g. https://www.example.com), used for canonical URLs
PRIMARY_DOMAIN=""
# Customer Account API client ID
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
# Customer Account API URL
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
# Numeric Shopify shop ID, required by the Customer Account API
SHOP_ID=""

# ------------------------------------------------------------------------------
# Optional: Pack
# ------------------------------------------------------------------------------

# Pack content environment to read from (defaults to production)
PUBLIC_PACK_CONTENT_ENVIRONMENT=""
# Set to "true" to log analytics events to the browser console
PUBLIC_PACK_ANALYTICS_DEBUG=""

# ------------------------------------------------------------------------------
# Optional: third-party analytics and integrations (each loads only when set)
# ------------------------------------------------------------------------------

# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
PUBLIC_GTM_CONTAINER_ID=""
# Google Analytics 4 tag ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA4_TAG_ID=""
# Elevar data layer signing key
PUBLIC_ELEVAR_SIGNING_KEY=""
# Blotout EdgeTag URL
PUBLIC_BLOTOUT_EDGE_URL=""
# Meta (Facebook) pixel ID
PUBLIC_META_PIXEL_ID=""
# TikTok pixel ID
PUBLIC_TIKTOK_PIXEL_ID=""
# Klaviyo public API key (site ID), used for onsite tracking and signups
PUBLIC_KLAVIYO_API_KEY=""
# Klaviyo private API key, used by the server-side signup route
PRIVATE_KLAVIYO_API_KEY=""
# Google reCAPTCHA v2 site key for the Form Builder section
PUBLIC_RECAPTCHA_SITE_KEY=""
